{
  "name": "webmcp-sdk",
  "version": "0.6.0",
  "description": "TypeScript toolkit for WebMCP: register site tools for AI agents, with React hooks, security helpers, audit logging, and testing utilities.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.mjs",
      "require": "./dist/security.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    },
    "./middleware/express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.mjs",
      "require": "./dist/middleware/express.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.mjs",
      "require": "./dist/x402.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "examples/browser-hello"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --root .",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run verify:release",
    "typecheck": "tsc --noEmit",
    "smoke:package": "node scripts/smoke-package-subpaths.mjs",
    "studio:dev": "npm run dev --workspace @webmcp/studio",
    "studio:test": "npm run test --workspace @webmcp/studio",
    "studio:build": "npm run build --workspace @webmcp/studio",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:python": "python3 scripts/verify-python.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:release": "npm run format:check && npm run typecheck && npm test && npm run build && npm run studio:test && npm run studio:build && npm run smoke:package && npm run verify:browser && npm run verify:python && npm audit --audit-level=low"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "chrome",
    "web-standard",
    "model-context-protocol",
    "agent-ready",
    "browser-api",
    "ai",
    "llm",
    "tools",
    "w3c",
    "navigator-modelcontext",
    "agentic-web",
    "tool-use"
  ],
  "author": "up2itnow",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/up2itnow0822/webmcp-sdk.git"
  },
  "homepage": "https://github.com/up2itnow0822/webmcp-sdk#readme",
  "bugs": {
    "url": "https://github.com/up2itnow0822/webmcp-sdk/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/react-test-renderer": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-test-renderer": "19.3.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  },
  "workspaces": [
    "apps/studio"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2",
    "vite": "$vite"
  }
}
